@model IEnumerable<FarmaSaludMVC.Models.Reserva>

@{
    ViewData["Title"] = "Mis Reservas";
}

<div class="container mt-4">
    <h2>Mis Reservas Realizadas</h2>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Fecha de Reserva</th>
                <th>Recoger Antes de</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.FechaReserva.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@r.FechaLimite.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge @(r.Estado == "En espera" ? "bg-warning" : "bg-success")">
                            @r.Estado
                        </span>
                    </td>
                    <td>
                        <a asp-action="Detalles" asp-route-id="@r.Id" class="btn btn-sm btn-info text-white">
                            <i class="bi bi-search"></i> Ver detalles
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>