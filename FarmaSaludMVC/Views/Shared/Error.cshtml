@model ErrorViewModel
@{
    ViewData["Title"] = "Error del Sistema";
}

<div class="container text-center mt-5">
    <div class="card shadow-lg border-0 p-5">
        <h1 class="display-1 text-danger"><i class="bi bi-bug-fill"></i></h1>
        <h2 class="fw-bold">Algo salió mal en FarmaSalud</h2>
        <p class="text-muted">Estamos experimentando dificultades técnicas. Por favor, intenta más tarde.</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-secondary">ID del Reporte: <code>@Model.RequestId</code></p>
        }

        <a href="/" class="btn btn-verde mt-3">Volver a la Farmacia</a>
    </div>
</div>