<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FarmaSalud</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --verde-pastel: #e8f5e9;
            --verde-fuerte: #2e7d32;
            --verde-hover: #c8e6c9;
            --sidebar-width: 260px;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        #sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background-color: var(--verde-pastel);
            color: var(--verde-fuerte);
            border-right: 1px solid #dee2e6;
            position: fixed;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            z-index: 1030;
        }

        .sidebar-header {
            padding: 25px 20px;
            background-color: var(--verde-hover);
            text-align: center;
            border-bottom: 1px solid #dee2e6;
        }

            .sidebar-header h3 {
                margin: 0;
                font-size: 1.3rem;
                font-weight: 800;
                color: var(--verde-fuerte);
            }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            padding: 15px 0;
        }

        .menu-label {
            padding: 10px 25px;
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            color: #6c757d;
            letter-spacing: 1px;
        }

        #sidebar ul li a {
            padding: 12px 25px;
            display: flex;
            align-items: center;
            color: var(--verde-fuerte);
            text-decoration: none;
            transition: all 0.2s ease;
        }

            #sidebar ul li a i {
                margin-right: 12px;
                font-size: 1.2rem;
            }

            #sidebar ul li a:hover {
                background-color: var(--verde-hover);
                padding-left: 30px;
            }

        #content {
            margin-left: var(--sidebar-width);
            padding: 40px 20px;
            min-height: 100vh;
        }

        .footer-sidebar {
            padding: 15px;
            font-size: 0.75rem;
            border-top: 1px solid var(--verde-hover);
            text-align: center;
            background-color: var(--verde-pastel);
        }

        @@media (max-width: 992px) {
            #sidebar {
                width: 70px;
            }

                #sidebar .sidebar-header h3, #sidebar .menu-label, #sidebar ul li a span {
                    display: none;
                }

            #content {
                margin-left: 70px;
            }

            #sidebar ul li a {
                justify-content: center;
                padding: 15px 0;
            }

                #sidebar ul li a i {
                    margin-right: 0;
                }
        }
    </style>
</head>
<body>

    <nav id="sidebar">
        <div class="sidebar-header">
            <h3>FARMA SALUD</h3>
        </div>

        <div class="sidebar-menu">
            <ul class="list-unstyled">
                <div class="menu-label">Tienda Virtual</div>
                <li>
                    <a asp-controller="Medicamento" asp-action="Catalogo">
                        <i class="bi bi-capsule"></i> <span>Catálogo</span>
                    </a>
                </li>

                @if (User.Identity.IsAuthenticated && (User.IsInRole("Cliente")))
                {
                    <li>
                        <a asp-controller="Carrito" asp-action="Index">
                            <i class="bi bi-cart3"></i> <span>Mi Carrito</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Reserva" asp-action="MisReservas">
                            <i class="bi bi-calendar-check"></i> <span>Mis Reservas</span>
                        </a>
                    </li>
                }

                @* Limitacion para Cliente: Solo Admin y SuperAdmin ven esto *@
                @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")))
                {
                    <hr class="mx-3 my-3 opacity-25">
                    <div class="menu-label">Administración</div>
                    <li>
                        <a asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Categorias" asp-action="Index">
                            <i class="bi bi-tags"></i> <span>Categorías</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Usuarios" asp-action="Index">
                            <i class="bi bi-people"></i> <span>Usuarios</span>
                        </a>
                    </li>
                }

                <hr class="mx-3 my-3 opacity-25">

                @if (User.Identity.IsAuthenticated)
                {
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-none"></form>
                        <a href="javascript:document.getElementById('logoutForm').submit()" class="text-danger">
                            <i class="bi bi-box-arrow-left"></i> <span>Cerrar Sesión</span>
                        </a>
                    </li>
                }
                else
                {
                    <li>
                        <a asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> <span>Iniciar Sesión</span>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <div class="footer-sidebar text-muted">
            &copy; 2026 - FarmaSalud
        </div>
    </nav>

    <div id="content">
        <main role="main" class="container-fluid">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>