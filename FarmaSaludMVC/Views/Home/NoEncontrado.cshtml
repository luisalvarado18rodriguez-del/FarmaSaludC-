@{
    ViewData["Title"] = "Página no encontrada";
}

<div class="container text-center mt-5">
    <div class="card shadow-lg border-0 p-5">
        <h1 class="display-1 text-warning"><i class="bi bi-exclamation-triangle"></i></h1>
        <h2 class="fw-bold">404 - No Encontrado</h2>
        <p class="text-muted">@ViewBag.Mensaje</p>
        <div class="mt-4">
            <a href="/" class="btn btn-success px-4">Volver al Inicio</a>
        </div>
    </div>
</div>