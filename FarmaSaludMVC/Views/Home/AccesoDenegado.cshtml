@{
    Layout = "_Layout";
    ViewData["Title"] = "Acceso Restringido";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-lg border-0 p-5">
                <div class="display-1 text-danger mb-4">
                    <i class="bi @ViewBag.Icono"></i>
                </div>
                <h2 class="fw-bold text-dark">Acceso Restringido</h2>
                <p class="text-muted mt-3">@ViewBag.Mensaje</p>

                <div class="mt-4">
                    <a href="/" class="btn btn-success px-4 py-2 shadow-sm">
                        Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>