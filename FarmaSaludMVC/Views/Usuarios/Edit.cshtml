@model FarmaSaludMVC.Models.Usuario

@{
    ViewData["Title"] = "Gestión de Seguridad";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 text-dark fw-bold">Actualizar Permisos de Cuenta</h5>
            </div>
            <div class="card-body px-4 py-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    @* Datos ocultos para no perder integridad en el POST *@
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Password" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-muted small fw-bold">IDENTIFICADOR DE USUARIO</label>
                        <input asp-for="Email" class="form-control bg-light border-0 fw-bold" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">NIVEL DE PRIVILEGIOS</label>

                        @if (Model.Rol == "Cliente")
                        {
                            <input type="text" class="form-control bg-light" value="Cliente" readonly />
                            <input type="hidden" asp-for="Rol" value="Cliente" />
                        }
                        else if (Model.Rol == "SuperAdmin")
                        {
                            <input type="text" class="form-control bg-light text-success fw-bold" value="Super Administrador" readonly />
                            <input type="hidden" asp-for="Rol" value="SuperAdmin" />
                        }
                        else
                        {
                            <select asp-for="Rol" class="form-select" asp-items="ViewBag.Roles"></select>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-danger">ESTADO DE ACCESO</label>

                        @if (Model.Rol == "SuperAdmin")
                        {
                            <select class="form-select border-0 shadow-sm text-success fw-bold" disabled style="background-color: #f1f3f5;">
                                <option>Acceso Permanente (Protegido)</option>
                            </select>
                            <input type="hidden" asp-for="Activo" value="true" />
                        }
                        else
                        {
                            <select asp-for="Activo" id="estadoSelector" class="form-select border-danger @(Model.Activo ? "text-success" : "text-danger") fw-bold">
                                <option value="true">Cuenta Activa</option>
                                <option value="false">Cuenta Inhabilitada (Baneo)</option>
                            </select>
                        }

                        <span asp-validation-for="Activo" class="text-danger small"></span>

                        <div class="form-text small mt-2">
                            <i class="bi bi-shield-check me-1"></i>
                            @(Model.Rol == "SuperAdmin" ? "Esta cuenta de sistema no puede ser inhabilitada." : "Determina si el usuario puede iniciar sesión en el sistema.")
                        </div>
                    </div>

                    <hr class="text-muted opacity-25">

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Index" class="btn btn-light px-4 border">Cancelar</a>
                        <button type="submit" class="btn btn-dark px-5 shadow-sm">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script mejorado para cambiar el color del texto dinámicamente al seleccionar
        document.getElementById('estadoSelector')?.addEventListener('change', function() {
            if (this.value === "true") {
                this.classList.remove('text-danger');
                this.classList.add('text-success');
            } else {
                this.classList.remove('text-success');
                this.classList.add('text-danger');
            }
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}