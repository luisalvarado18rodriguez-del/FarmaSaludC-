@model FarmaSaludMVC.Models.Usuario

@{
    ViewData["Title"] = "Confirmar Restricción";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg">
                @if (Model.Rol == "SuperAdmin")
                {
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <i class="bi bi-shield-lock-fill text-warning" style="font-size: 4rem;"></i>
                        </div>
                        <h4 class="fw-bold">Acción Denegada</h4>
                        <p class="text-muted px-4">
                            La cuenta <strong>@Model.Email</strong> posee privilegios de Sistema (SuperAdmin) y no puede ser inhabilitada ni eliminada por motivos de seguridad jerárquica.
                        </p>
                        <div class="mt-4">
                            <a asp-action="Index" class="btn btn-dark px-5">Regresar al Listado</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-header bg-white border-0 pt-4 text-center">
                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-exclamation-triangle text-danger fs-3"></i>
                        </div>
                        <h4 class="fw-bold mb-0">Confirmar Restricción</h4>
                        <p class="text-muted small">¿Está seguro de que desea revocar el acceso a este usuario?</p>
                    </div>

                    <div class="card-body px-4 pb-4">
                        <div class="bg-light rounded-3 p-3 mb-4">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted small text-uppercase">Usuario</dt>
                                <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Email)</dd>

                                <dt class="col-sm-4 text-muted small text-uppercase">Rol Actual</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Rol)</dd>

                                <dt class="col-sm-4 text-muted small text-uppercase">Estado</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @(Model.Activo ? "bg-success" : "bg-danger") px-2">
                                        @(Model.Activo ? "ACTIVO" : "YA RESTRINGIDO")
                                    </span>
                                </dd>
                            </dl>
                        </div>

                        <div class="alert alert-secondary border-0 small d-flex align-items-center" style="background-color: #f8f9fa;">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            El usuario no podrá volver a iniciar sesión, pero sus registros históricos se mantendrán.
                        </div>

                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Index" class="btn btn-light border px-4">Cancelar</a>
                                <button type="submit" class="btn btn-danger px-4 shadow-sm">
                                    Confirmar Inhabilitación
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>