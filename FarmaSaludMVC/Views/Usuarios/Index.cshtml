@model IEnumerable<FarmaSaludMVC.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-verde font-weight-bold">Registro de Usuarios</h2>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-person-plus-fill"></i> Nuevo Usuario
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="d-flex border rounded shadow-sm bg-white p-1">
            <input type="text" name="buscar" value="@ViewData["FiltroActual"]"
                   class="form-control border-0 shadow-none"
                   placeholder="Buscar por email de usuario..." />

            <button type="submit" class="btn btn-verde px-4">
                <i class="bi bi-search"></i>
            </button>
           
            @if (!string.IsNullOrEmpty(ViewData["FiltroActual"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-light border-start text-muted" title="Limpiar búsqueda">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
        <br>

        @if (User.IsInRole("SuperAdmin"))
        {
            <div class="mb-4">
                <a asp-action="Clientes" class="btn btn-dark btn-modern">
                    <i class="bi bi-people-fill me-2"></i> GESTIONAR CLIENTES
                </a>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Usuario / Email</th>
                        <th class="text-center">Rol</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                                No se encontraron usuarios que coincidan con la búsqueda.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-verde-pastel text-verde d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-person-circle fs-5"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.Email</span>
                                </div>
                            </td>
                            <td class="text-center">
                                @switch (item.Rol)
                                {
                                    case "SuperAdmin":
                                        <span class="badge rounded-1 py-2 px-3" style="background-color: #1b5e20; color: #ffffff; font-size: 0.7rem; letter-spacing: 0.5px;">
                                            SYSTEM
                                        </span>
                                        break;

                                    case "Admin":
                                        <span class="badge rounded-1 py-2 px-3" style="background-color: #2e7d32; color: #ffffff; font-size: 0.7rem; letter-spacing: 0.5px;">
                                            ADMINISTRADOR
                                        </span>
                                        break;

                                    default:
                                        <span class="badge rounded-1 py-2 px-3 text-muted border" style="background-color: #f8f9fa; font-size: 0.7rem; letter-spacing: 0.5px;">
                                            Cliente
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Activo)
                                {
                                    <span class="text-success fw-bold">
                                        <i class="bi bi-check-circle-fill me-1"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">
                                        <i class="bi bi-x-circle-fill me-1"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .text-verde {
            color: #2e7d32;
        }

        .bg-verde-pastel {
            background-color: #e8f5e9;
        }

        .btn-verde {
            background-color: #2e7d32;
            color: white;
            border: none;
        }

            .btn-verde:hover {
                background-color: #1b5e20;
                color: white;
            }

        .table thead th {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
            color: #666;
            border-top: none;
        }

        .table-hover tbody tr:hover {
            background-color: #f1f8f1;
        }

        .badge {
            font-weight: 500;
        }

        /* Quitar borde azul del input al hacer click */
        .form-control:focus {
            box-shadow: none;
        }
    </style>
}