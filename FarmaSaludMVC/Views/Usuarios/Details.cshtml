@model FarmaSaludMVC.Models.Usuario

@{
    ViewData["Title"] = "Detalles de Usuario";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-4">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-success">Usuarios</a></li>
                    <li class="breadcrumb-item active">Detalles</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-light p-3 me-3">
                            <i class="bi bi-shield-lock text-secondary fs-4"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">Información de Seguridad</h5>
                            <span class="text-muted small">Gestión de acceso al sistema</span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <table class="table mb-0">
                        <tbody>
                            <tr class="border-top">
                                <th class="ps-4 py-3 bg-light text-muted small text-uppercase" style="width: 30%;">Identificador</th>
                                <td class="ps-4 py-3 fw-bold text-dark">@Html.DisplayFor(model => model.Email)</td>
                            </tr>
                            <tr>
                                <th class="ps-4 py-3 bg-light text-muted small text-uppercase">Nivel de Acceso</th>
                                <td class="ps-4 py-3">
                                    <span class="badge @(Model.Rol == "SuperAdmin" ? "bg-dark" : "bg-secondary") px-3">
                                        @Html.DisplayFor(model => model.Rol)
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th class="ps-4 py-3 bg-light text-muted small text-uppercase">Estado Actual</th>
                                <td class="ps-4 py-3">
                                    @if (Model.Activo)
                                    {
                                        <span class="text-success fw-bold small">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> CUENTA ACTIVA
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold small">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> ACCESO BLOQUEADO
                                        </span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th class="ps-4 py-3 bg-light text-muted small text-uppercase">Credenciales</th>
                                <td class="ps-4 py-3">
                                    <span class="text-muted small italic">
                                        <i class="bi bi-info-circle me-1"></i> Protegidas por cifrado de servidor
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-white border-0 py-4 px-4">
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border px-4">
                            Volver al Listado
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-dark px-4 shadow-sm">
                            <i class="bi bi-pencil-square me-2"></i>Editar Permisos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .breadcrumb-item + .breadcrumb-item::before {
            content: ">";
        }

        .table th {
            font-weight: 600;
        }
    </style>
}