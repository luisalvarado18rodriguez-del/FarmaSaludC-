@model FarmaSaludMVC.Models.Usuario

@{
    ViewData["Title"] = "Nuevo Registro";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 text-dark fw-bold">Registro de Nuevo Operador</h5>
            </div>
            <div class="card-body px-4 py-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-muted small fw-bold">CORREO ELECTRÓNICO</label>
                        <input asp-for="Email" class="form-control border-0 bg-light py-2" placeholder="usuario@dominio.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-muted small fw-bold">CONTRASEÑA INICIAL</label>
                        @* Agregamos type="password" para que no se vea al escribir *@
                        <input asp-for="Password" type="password" class="form-control border-0 bg-light py-2" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Rol" class="form-label text-muted small fw-bold">ROL</label>
                            <select asp-for="Rol" class="form-select border-0 bg-light" asp-items="ViewBag.Roles">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">ESTADO INICIAL</label>
                            <select asp-for="Activo" class="form-select border-0 bg-light fw-bold text-success">
                                <option value="true">Acceso Permitido</option>
                                <option value="false" class="text-danger">Baneado</option>
                            </select>
                        </div>
                    </div>

                    <div class="alert alert-light border-0 small mt-3 py-2" style="background-color: #fcfcfc;">
                        <p class="mb-0 text-muted">
                            <i class="bi bi-info-circle me-1"></i> Por seguridad, el rol "SuperAdmin" solo puede ser asignado mediante base de datos.
                        </p>
                    </div>

                    <hr class="my-4 opacity-25">

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-link text-muted text-decoration-none px-4">Cancelar</a>
                        <button type="submit" class="btn btn-dark px-5 shadow-sm">
                            Registrar Usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}