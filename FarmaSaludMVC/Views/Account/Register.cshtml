@model FarmaSaludMVC.ViewModels.RegistroVM

@{
    Layout = null;
    ViewData["Title"] = "Crear Cuenta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FarmaSalud</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
            <div class="col-11 col-sm-10 col-md-8 col-lg-6">

                <div class="card border-0 shadow-lg my-5">
                    <div class="card-body p-4 p-md-5">
                        <h2 class="text-center mb-4 text-success font-weight-bold">Crear Cuenta Cliente</h2>

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <form asp-action="Register" method="post">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DNI" class="form-label font-weight-bold">DNI</label>
                                    <input asp-for="DNI" class="form-control" placeholder="8 dígitos" />
                                    <span asp-validation-for="DNI" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label font-weight-bold">Email</label>
                                    <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Nombre" class="form-label font-weight-bold">Nombre</label>
                                    <input asp-for="Nombre" class="form-control" />
                                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Apellido" class="form-label font-weight-bold">Apellido</label>
                                    <input asp-for="Apellido" class="form-control" />
                                    <span asp-validation-for="Apellido" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label font-weight-bold">Contraseña</label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Mínimo 6 caracteres" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmarPassword" class="form-label font-weight-bold">Confirmar Contraseña</label>
                                <input asp-for="ConfirmarPassword" class="form-control" type="password" />
                                <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg w-100 shadow-sm">Registrarse</button>
                        </form>

                        <div class="text-center mt-4">
                            <p class="mb-0 text-muted">¿Ya tienes una cuenta?</p>
                            <a asp-action="Login" asp-controller="Account" class="text-primary font-weight-bold">Inicia sesión aquí</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>