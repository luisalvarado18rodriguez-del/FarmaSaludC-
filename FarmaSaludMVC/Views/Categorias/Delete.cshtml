@model FarmaSaludMVC.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="bi bi-exclamation-octagon-fill text-danger display-4"></i>
                </div>
                <h3 class="fw-bold text-dark">¿Confirmar eliminación?</h3>
                <p class="text-muted">
                    Estás a punto de borrar la categoría <strong>"@Model.Nombre"</strong>.
                    Esta acción no se puede deshacer.
                </p>

                <div class="alert alert-warning border-0 small mt-3">
                    <i class="bi bi-lightbulb me-1"></i>
                    Asegúrate de que no haya medicamentos asociados a esta categoría antes de proceder.
                </div>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger py-2 fw-bold shadow-sm">
                            <i class="bi bi-trash3-fill me-1"></i>Eliminar permanentemente
                        </button>
                        <a asp-action="Index" class="btn btn-light py-2 border shadow-sm small text-muted">
                            No, mantener registro
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>