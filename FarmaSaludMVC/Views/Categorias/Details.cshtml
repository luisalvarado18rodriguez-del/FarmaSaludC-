@model FarmaSaludMVC.Models.Categoria

@{
    ViewData["Title"] = "Detalles de Categoría";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="bi bi-info-circle-fill text-info display-4"></i>
                </div>
                <h6 class="text-muted small text-uppercase fw-bold mb-1">Información del Registro</h6>
                <h2 class="fw-bold text-dark mb-4">@Html.DisplayFor(model => model.Nombre)</h2>

                <hr class="my-4" />

                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary px-4 shadow-sm">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </a>
                    <a asp-action="Index" class="btn btn-light px-4 border shadow-sm">
                        Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>