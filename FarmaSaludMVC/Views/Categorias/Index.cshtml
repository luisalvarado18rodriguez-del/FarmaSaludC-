@model IEnumerable<FarmaSaludMVC.Models.Categoria>

@{
    ViewData["Title"] = "Gestión de Inventario";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-verde fw-bold mb-0">Categorías de Productos</h2>
        <p class="text-muted small">Clasificación lógica para el catálogo de medicamentos</p>
    </div>
    <a asp-action="Create" class="btn btn-success shadow-sm px-4">
        <i class="bi bi-plus-lg me-2"></i>Nueva Categoría
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
            
                        <th class="py-3">Nombre de la Categoría</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                     
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded bg-verde-pastel text-verde d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                                        <i class="bi bi-tag-fill" style="font-size: 0.9rem;"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.Nombre</span>
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white btn-sm border shadow-sm" title="Editar">
                                        <i class="bi bi-pencil-square text-primary"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-white btn-sm border shadow-sm" title="Ver detalles">
                                        <i class="bi bi-info-circle text-info"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-white btn-sm border shadow-sm" title="Eliminar">
                                        <i class="bi bi-trash3 text-danger"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        :root {
            --verde-corp: #2e7d32;
            --verde-bg: #e8f5e9;
        }

        .text-verde {
            color: var(--verde-corp);
        }

        .bg-verde-pastel {
            background-color: var(--verde-bg);
        }

        .table thead th {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05rem;
            color: #495057;
            border-bottom: 2px solid #f8f9fa;
        }

        .btn-white {
            background-color: #fff;
            border-color: #dee2e6;
        }

            .btn-white:hover {
                background-color: #f8f9fa;
                border-color: #ced4da;
            }

        /* Estilo para filas vacías o hover */
        .table-hover tbody tr:hover {
            background-color: #fafafa;
        }
    </style>
}