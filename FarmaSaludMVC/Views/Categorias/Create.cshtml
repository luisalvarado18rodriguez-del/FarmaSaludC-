@model FarmaSaludMVC.Models.Categoria

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            @* Encabezado con el tono verde de la marca *@
            <div class="card-header bg-white py-3 border-0">
                <h5 class="mb-0 text-dark fw-bold text-center">
                    <i class="bi bi-tag-fill me-2 text-success"></i>Registrar Nueva Categoría
                </h5>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small border-0"></div>

                    <div class="mb-4">
                        <label asp-for="Nombre" class="form-label text-muted small fw-bold">NOMBRE DE LA CATEGORÍA</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-pencil-square"></i></span>
                            <input asp-for="Nombre" class="form-control bg-light border-0 shadow-sm" placeholder="Ej: Analgésicos, Vitaminas..." />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark py-2 shadow-sm fw-bold">
                            <i class="bi bi-plus-circle me-1"></i>Crear Categoría
                        </button>
                        <a asp-action="Index" class="btn btn-light py-2 border shadow-sm small text-muted">
                            Volver al Listado
                        </a>
                    </div>
                </form>
            </div>
        </div>

        @* Pequeño tip informativo abajo *@
        <div class="text-center mt-3 text-muted small">
            <i class="bi bi-info-circle me-1"></i> Las categorías ayudan a los clientes a encontrar productos más rápido.
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}